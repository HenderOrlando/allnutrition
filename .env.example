# COPIA este archivo como .env. No lo subas a Git y no pegues secretos en el chat.
# LOCAL: auto sin URL utiliza SQLite. VERCEL: usa supabase y una conexión real.
DB_DRIVER=auto
DATABASE_URL=
# Alias opcional: se usa con prioridad sobre DATABASE_URL.
SUPABASE_DATABASE_URL=
# Solo para migraciones: conexión directa/session pooler con permisos DDL.
DATABASE_DIRECT_URL=
DB_POOL_MAX=1
DB_SSL=verify
# Certificado raíz PEM de Supabase si es necesario; admite saltos escapados \\n.
DB_CA_CERT=
SQLITE_PATH=./data/all-nutrition.sqlite
APP_URL=http://localhost:3000
EXTRA_ALLOWED_ORIGINS=

# SOLO setup/CLI local. Usa tu correo y una clave única de >=14 caracteres.
# No necesitas poner estas dos variables en Vercel después de crear la cuenta.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SOLO pruebas contra una base PostgreSQL descartable llamada allnutrition_test.
TEST_DATABASE_URL=
TEST_ALLOW_DATABASE_RESET=

# Redes sociales se configura desde Configuración, sin reiniciar procesos.
# Custodia persistente privada 0700/0600; respaldar ambos directorios por separado.
INTEGRATION_SECRETS_DIR=./data/integration-secrets
SOCIAL_BROWSER_CONTROL_DIR=./data/social-browser-control
# Runner privado con Chromium sandbox; recibe sólo el volumen de control (lectura).
SOCIAL_BROWSER_URL=http://social-browser:3320
SOCIAL_BROWSER_MAX_CONTEXTS=2
SOCIAL_MEDIA_DIR=./data/social-media
SOCIAL_MEDIA_QUOTA_BYTES=10737418240

# Ali: OAuth oficial de Google/Gemini, opcional; APIKey sigue disponible en el panel.
# Cliente OAuth tipo Web, API Generative Language y consentimiento configurados en Google.
# Registrar exactamente APP_URL + /api/admin/assistant/oauth/callback.
ASSISTANT_GOOGLE_CLIENT_ID=
ASSISTANT_GOOGLE_CLIENT_SECRET=
