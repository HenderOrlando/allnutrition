# The candidate checkout is the build context. No Next build is performed here.
FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
COPY package*.json ./
COPY scripts/install.mjs ./scripts/install.mjs
RUN node scripts/install.mjs
ARG CHECKS_CHROMIUM=0
ARG CHECKS_FFMPEG=0
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN set -e; \
    if [ "$CHECKS_FFMPEG" = 1 ]; then apt-get update; apt-get install -y --no-install-recommends ffmpeg; fi; \
    if [ "$CHECKS_CHROMIUM" = 1 ]; then ./node_modules/.bin/playwright install --with-deps chromium; chmod -R a+rX /ms-playwright; fi; \
    rm -rf /var/lib/apt/lists/*

FROM dependencies AS checks
COPY . .
COPY --from=heka_contract /heka.mjs ./desktop/providers/heka.mjs
ENV NEXT_TELEMETRY_DISABLED=1

FROM checks AS checks-with-web
COPY --from=accepted_web / /app/.next/
