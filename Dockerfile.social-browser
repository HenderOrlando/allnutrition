FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright SOCIAL_MEDIA_DIR=/app/data/social-media
COPY package*.json ./
RUN npm ci --omit=dev --legacy-peer-deps && ./node_modules/.bin/playwright install --with-deps chromium && npm cache clean --force
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts/social-browser.mjs ./scripts/social-browser.mjs
RUN mkdir -p /app/data/social-media && chown node:node /app/data /app/data/social-media && chmod 700 /app/data /app/data/social-media
USER node
CMD ["node", "scripts/social-browser.mjs"]
