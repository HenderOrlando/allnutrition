# Configurar como variables del servidor en Vercel (NO NEXT_PUBLIC_).
DB_DRIVER=supabase
# Pegar cadena "Transaction pooler" de Connect en Supabase, con la contraseña codificada.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_REAL_DEL_POOLER:6543/postgres
DB_SSL=verify
DB_POOL_MAX=1
# Cambiar por la URL real .vercel.app o el dominio ya conectado.
APP_URL=https://NOMBRE_REAL_DEL_PROYECTO.vercel.app
# Solo si la cadena TLS necesita el certificado raíz del proyecto:
DB_CA_CERT=

# Redes sociales se configura desde Configuración; no guardar sus secretos en .env.
# Custodia privada persistente compartida por web/workers, fuera del respaldo comercial.
INTEGRATION_SECRETS_DIR=/app/data/integration-secrets
# El runner monta únicamente esta custodia de control, de solo lectura.
SOCIAL_BROWSER_CONTROL_DIR=/app/data/social-browser-control
SOCIAL_BROWSER_URL=http://social-browser:3320
SOCIAL_BROWSER_MAX_CONTEXTS=2
SOCIAL_MEDIA_DIR=/app/data/social-media
SOCIAL_MEDIA_QUOTA_BYTES=10737418240

# Ali: OAuth Google/Gemini opcional, solo servidor; nunca NEXT_PUBLIC_.
# Registrar APP_URL + /api/admin/assistant/oauth/callback en el cliente OAuth Web.
ASSISTANT_GOOGLE_CLIENT_ID=
ASSISTANT_GOOGLE_CLIENT_SECRET=
